# ==============================================================================
# MyStock AI Terminal — Environment Configuration Template
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Server Network Configuration (default host and port)
HOST=127.0.0.1
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Ollama LLM and Embeddings Configuration
# For local host execution: http://localhost:11434
# For Docker Compose execution: http://ollama:11434
# For Kubernetes execution: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=nomic-embed-text

# Persistent Storage Locations
FAISS_PATH=./data/faiss
DB_PATH=sqlite:///./data/stock_terminal.db
UPLOAD_DIR=./uploads

# Optional Basic Authentication (disabled by default)
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional Third-Party Market Data API Keys
UPSTOX_ACCESS_TOKEN=
FINNHUB_API_KEY=
