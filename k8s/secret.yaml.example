apiVersion: v1
kind: Secret
metadata:
  name: stockrag-secret
  namespace: stockrag
  labels:
    app.kubernetes.io/name: stockrag
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # Replace with actual tokens or keep empty if unused
  UPSTOX_ACCESS_TOKEN: ""
  FINNHUB_API_KEY: ""
  AUTH_USERNAME: "admin"
  AUTH_PASSWORD: "change-me-in-production"
